# Postgres connection string. Get it from Supabase:
#   Project → Settings → Database → Connection string → "Transaction pooler"
# (URI form). The transaction pooler is the right one for serverless/Vercel.
#
# Example shape (yours will differ):
#   DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# Copy this file to .env (gitignored) and fill it in for local dev. On Vercel,
# set DATABASE_URL as a Project Environment Variable instead.
DATABASE_URL=

# Optional: max pool size (defaults to 5).
# PGMAX=5

# REQUIRED for sign-in: secret that signs session cookies. Generate one with
#   openssl rand -base64 32
# Rotating it invalidates all existing staff sessions (they just sign in again).
# Set it in .env locally and as an env var on Vercel.
AUTH_SECRET=

# Optional: session lifetime in seconds (default 43200 = 12h).
# SESSION_TTL_SECONDS=43200

# Starter staff accounts, seeded on first boot (idempotent; survive demo reset).
# CHANGE THESE before any real deployment — at minimum the admin password.
# In production (Vercel / NODE_ENV=production), leaving a password unset logs a
# loud SECURITY WARNING. Set SEED_STRICT=1 to instead REFUSE to boot until real
# passwords are provided.
# SEED_ADMIN_EMAIL=admin@valet.local
# SEED_ADMIN_PASSWORD=admin1234
# SEED_DRIVER_EMAIL=driver@valet.local
# SEED_DRIVER_PASSWORD=driver1234
# SEED_WAREHOUSE_EMAIL=warehouse@valet.local
# SEED_WAREHOUSE_PASSWORD=warehouse1234
# SEED_STRICT=1

# Rate limits (src/ratelimit.js). Best-effort/per-instance on serverless.
# Login: 10 attempts / 15 min per IP+email, and 30 per IP across all emails.
# LOGIN_RATE_MAX=10
# LOGIN_IP_RATE_MAX=30
# LOGIN_RATE_WINDOW_MS=900000
# Public bookings and waitlist sign-ups per IP per hour.
# BOOKING_RATE_MAX=10
# LEADS_RATE_MAX=10
# Trust X-Forwarded-For for client IPs. Automatic on Vercel; set to 1 only
# behind another proxy that sets it, or clients can fake their IP.
# TRUST_PROXY=1

# Booking confirmation email (src/notify.js). Optional — if RESEND_API_KEY is
# unset, confirmation emails are skipped (no error). Get a key at resend.com.
# EMAIL_FROM defaults to Resend's test sender; set a verified-domain address for
# production so mail doesn't land in spam.
# RESEND_API_KEY=
# EMAIL_FROM=Store All Valet <onboarding@resend.dev>

# Job-completion SMS (src/notify.js). Optional — if TWILIO_* are unset, SMS is
# skipped (no error). Uses Twilio's REST API via fetch (no SDK).
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+15551234567

# Links we send customers (confirmation email, phone lookup, job-done SMS).
# Defaults to Vercel's production URL; set it if you use a custom domain.
# PUBLIC_BASE_URL=https://valet.example.com
# Phone lookups per IP per 15 min (default 10).
# LOOKUP_RATE_MAX=10

# Contents photo storage (src/storage.js). Requires a Supabase project.
# Create a PRIVATE bucket named contents-photos (or set SUPABASE_STORAGE_BUCKET).
# Photos are served as short-lived signed URLs (PHOTO_URL_TTL_SECONDS, default 3600).
# Service role key: Project → Settings → API → service_role (server only — never expose to browser).
# SUPABASE_URL is optional if DATABASE_URL contains postgres.<ref> (auto-derived).
# SUPABASE_URL=https://your-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=contents-photos

# Billing (src/billing.js). Prices in BDS$. The app works out what's due;
# Store All charges it on Plug'n Pay.
# STORAGE_PRICE_PER_BIN=30
# RETRIEVAL_FEE=50

# Customer T&Cs. Bump TERMS_VERSION whenever the published terms change; each
# booking records the version accepted. TERMS_URL is linked on the booking form.
# TERMS_VERSION=draft
# TERMS_URL=https://example.com/valet-terms
